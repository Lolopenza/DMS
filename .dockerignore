node_modules/
npm-debug.log
yarn-error.log
.npm/
.yarn/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
*.egg-info/
dist/
build/
.pytest_cache/
.coverage
htmlcov/

# Java/Maven
target/
*.class
*.jar
*.war
*.ear
.mvn/
mvnw
mvnw.cmd

# IDEs
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Git
.git/
.gitignore
.gitattributes

# Docker
.dockerignore
Dockerfile
docker-compose*.yml

# Logs
*.log
logs/

# Environment
.env.local
.env.*.local

# Build artifacts
dist/
build/
out/

# Documentation
*.md
docs/

# Tests
*.test.js
*.spec.js
test/
tests/
__tests__/
